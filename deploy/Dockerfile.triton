# Triton Inference Server image for the Decider, for SageMaker and anything else.
#
# FROM the SageMaker Triton DLC rather than NGC's `tritonserver`, because the DLC already
# carries SageMaker's contract: `serve` as the entrypoint verb, /invocations and /ping on
# 8080, and the CloudWatch metrics plumbing behind SAGEMAKER_TRITON_ALLOW_METRICS.
#
# VERIFIED about the base image (26.05-py3, inspected on an L4 2026-10-06), because both
# facts decide the rest of this file:
#
#   * Backends present: dali fil identity onnxruntime python pytorch repeat square tensorrt.
#   * The python backend's interpreter is Python 3.12.3 and has **numpy 1.26.4 and pydantic
#     2.10.6 and nothing else** -- no torch, transformers, peft, triton or fla. The
#     `pytorch` backend in that list is the C++ libtorch one and does not help a python
#     backend, so the whole stack has to be installed here.
#   * gcc, cc, g++, ld and /usr/include/python3.12/Python.h are ALL present. That matters
#     more than it looks: Triton (the GPU kernel compiler) builds its CUDA driver shim at
#     *runtime*, and when it cannot, `flash-linear-attention` catches the error and silently
#     falls back to a CPU reference path -- the server then starts, reports healthy and
#     answers correctly, with all 18 Gated DeltaNet layers slow. serving/README.md records
#     the first HF image shipping in exactly that state and passing the whole smoke test.
#     This base image satisfies the requirement, so nothing extra is installed for it; the
#     backend still asserts it at startup (model.py::_assert_fla_on_gpu) because a future
#     base image could drop the toolchain silently.
#
# Build it on an in-region amd64 host, not a Mac: deploy/build_on_box.sh. The base alone is
# 27.7 GB, and the LambdaGpuLaunchDemo build-box README measured 106 s in-region against
# ~60 min pushing from the laptop.

ARG TRITON_IMAGE=763104351884.dkr.ecr.us-west-2.amazonaws.com/sagemaker-tritonserver:26.05-py3

# ----------------------------------------------------------------------------------------
# Stage 1: fold the LoRA into the torso, on CPU.
#
# Done at build time so there is no PEFT at runtime and no per-cold-start merge. Measured
# (/opt/prof/merge.py): aten::mm 558 -> 186 per forward, torso forward 1.59x at 256 tokens
# and 1.86x at 4,096. The merge itself takes 0.12 s; downloading the weights is the slow
# part. Correctness was checked separately (/opt/prof/ab.py: 0 of 6 decision flips, max
# |delta noul| 0.0078) -- merge_lora.py's own guard is structural only, see its docstring.
# ----------------------------------------------------------------------------------------
FROM ${TRITON_IMAGE} AS merge

ARG SD_CHECKPOINT_REPO=StrandsAgents/strands-decider-2B-hobson-v21
ARG SD_CHECKPOINT_REVISION=main
ARG TORCH_VERSION=2.7.1+cu126
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
ARG TRANSFORMERS_VERSION=5.18.0
ARG PEFT_VERSION=0.21.0

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_DISABLE_TELEMETRY=1

# MEASURED, and the single most expensive mistake in this build: `torch==2.7.1` without the
# `+cu126` local version does NOT hold. With PyPI reachable (required -- see below) a later
# `pip install transformers ...` silently upgraded torch to 2.14.1 / triton 3.8.0, and
# `fla 0.5.2` then dies on import with:
#
#     torch/_inductor/kernel/flex_attention.py:692  TritonTemplate(...)
#     torch/_inductor/select_algorithm.py:2710      AssertionError: duplicate template name
#
# Verified by downgrading in a container: torch 2.14.1 -> `import fla` raises; torch
# 2.7.1+cu126 -> `FLA_OK platform=cuda`. The exact local version cannot be satisfied from
# PyPI, and the constraint file stops every subsequent pip invocation from moving it.
# The constraint drops the `+cu126` local segment -- `${TORCH_VERSION%%+*}`. A constraint
# carrying a local version does not satisfy a plain range, so `torch==2.7.1+cu126` here
# makes pip report:
#     Cannot install peft==0.21.0 ... peft depends on torch>=1.13.0
#     The user requested (constraint) torch==2.7.1+cu126
# `torch==2.7.1` matches 2.7.1+cu126 under PEP 440 and satisfies >=1.13.0, so it pins the
# version without breaking resolution. The INSTALL below keeps the local version, which is
# what actually forces the cu126 wheel.
RUN printf 'torch==%s\n' "${TORCH_VERSION%%+*}" > /etc/pip-constraints.txt \
 && cat /etc/pip-constraints.txt
ENV PIP_CONSTRAINT=/etc/pip-constraints.txt

# peft only exists in this stage: it is what performs the merge, and shipping it to the
# runtime would invite someone loading an unmerged checkpoint there by accident.
RUN python3 -m pip install --no-cache-dir \
        --index-url "${TORCH_INDEX_URL}" --extra-index-url https://pypi.org/simple \
        "torch==${TORCH_VERSION}" \
 && python3 -m pip install --no-cache-dir \
        "transformers==${TRANSFORMERS_VERSION}" \
        "peft==${PEFT_VERSION}" \
        "huggingface_hub[cli]" hf-xet safetensors accelerate \
        --ignore-installed typing_extensions

COPY serving/merge_lora.py /tmp/merge_lora.py
# merge_lora.py imports `strands_decider.modeling` -- it reads the checkpoint's own
# StrandsDeciderConfig and mirrors `_load_torso`'s Qwen3.5 branch, which is the whole point
# (a name mismatch there makes PEFT report an *empty* merge rather than an error). So the
# package has to be on the path in this stage too, not just the runtime.
COPY src/strands_decider /opt/strands-decider/strands_decider
# APPEND to PYTHONPATH, never replace it. The DLC base ships
# `PYTHONPATH=/opt/tritonserver/backends/dali/wheel/dali:` and `typing_extensions` 4.16.0
# lives ONLY in that DALI wheel directory -- it is not in site-packages, so
# `pip install typing_extensions` reports "already satisfied" and installs nothing.
# Clobbering PYTHONPATH therefore deletes typing_extensions (and /opt/tritonserver) from
# sys.path, and `import torch` dies on `from typing_extensions import ParamSpec`.
ENV PYTHONPATH=/opt/strands-decider:$PYTHONPATH

# Prove the install is usable BEFORE the 4.6 GB download, so a broken dependency set costs
# seconds rather than minutes.
#
# This check sits AFTER the ENV above on purpose. Placed before it, the same check passed
# while the real step failed -- a guard that does not run in the configuration that breaks
# is not a guard. It also imports strands_decider.modeling, so a missing torso dependency
# fails here in seconds rather than after the download.
RUN python3 -c "import torch, transformers, peft, typing_extensions; \
import strands_decider.modeling as m; \
print('merge stage ok:', torch.__version__, transformers.__version__, peft.__version__)"

# `--exclude` keeps the eval and training trees out; they are large and unused at serving
# time. The checkpoint itself is ~92 MB (67 MB of that the adapter), the base is ~4.57 GB.
RUN --mount=type=secret,id=hf_token,required=false \
    set -eux; \
    if [ -f /run/secrets/hf_token ]; then \
        HF_TOKEN="$(cat /run/secrets/hf_token)"; export HF_TOKEN; \
    fi; \
    hf download "${SD_CHECKPOINT_REPO}" --revision "${SD_CHECKPOINT_REVISION}" \
        --local-dir /opt/decider --exclude "eval/*" --exclude "training/*"; \
    python3 /tmp/merge_lora.py /opt/decider /opt/merged; \
    # The merged torso must not carry an adapter -- merged_engine.py refuses one, because
    # serving a checkpoint as if it were merged would answer as the un-adapted base.
    test ! -d /opt/merged/lora; \
    du -sh /opt/decider /opt/merged

# ----------------------------------------------------------------------------------------
# Stage 2: the runtime.
# ----------------------------------------------------------------------------------------
FROM ${TRITON_IMAGE} AS runtime

ARG TORCH_VERSION=2.7.1+cu126
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
ARG TRANSFORMERS_VERSION=5.18.0
ARG FLA_VERSION=0.5.2
ARG CAUSAL_CONV1D_VERSION=1.7.0
# Ampere + Ada. This list is the GPU families the image can actually be scheduled on, and
# narrowing it is a trap I walked into: an earlier build used "8.9" alone (the L4 on g6),
# which made the image hostage to one family. When every Ada SageMaker instance type in
# us-west-2 returned InsufficientInstanceCapacity -- ml.g6.xlarge, ml.g6e.xlarge,
# ml.g6.2xlarge and ml.g6.4xlarge, four consecutive 31-minute failures -- the ml.g5 family
# (A10G, sm_86) had quota and capacity, and the Ada-only image could not use it.
#
#   8.0  A100          8.6  A10G (ml.g5)      8.9  L4 / L40S (ml.g6, ml.g6e)
#
# Hopper (9.0) is omitted: no H100 quota here, and each arch costs build time.
# Blackwell (10.0;12.0) additionally needs a CUDA 12.8+ torch.
#
# Note the arch count is NOT what makes this slow: 8.9 alone took the same ~19 minutes as
# four arches did. Something else in causal-conv1d's build dominates on 4 vCPUs.
ARG TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9"
# setuptools defaults to a single compile job, which is most of the problem above.
ARG MAX_JOBS=4

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    MAX_JOBS=${MAX_JOBS}

# MEASURED, and the single most expensive mistake in this build: `torch==2.7.1` without the
# `+cu126` local version does NOT hold. With PyPI reachable (required -- see below) a later
# `pip install transformers ...` silently upgraded torch to 2.14.1 / triton 3.8.0, and
# `fla 0.5.2` then dies on import with:
#
#     torch/_inductor/kernel/flex_attention.py:692  TritonTemplate(...)
#     torch/_inductor/select_algorithm.py:2710      AssertionError: duplicate template name
#
# Verified by downgrading in a container: torch 2.14.1 -> `import fla` raises; torch
# 2.7.1+cu126 -> `FLA_OK platform=cuda`. The exact local version cannot be satisfied from
# PyPI, and the constraint file stops every subsequent pip invocation from moving it.
# The constraint drops the `+cu126` local segment -- `${TORCH_VERSION%%+*}`. A constraint
# carrying a local version does not satisfy a plain range, so `torch==2.7.1+cu126` here
# makes pip report:
#     Cannot install peft==0.21.0 ... peft depends on torch>=1.13.0
#     The user requested (constraint) torch==2.7.1+cu126
# `torch==2.7.1` matches 2.7.1+cu126 under PEP 440 and satisfies >=1.13.0, so it pins the
# version without breaking resolution. The INSTALL below keeps the local version, which is
# what actually forces the cu126 wheel.
RUN printf 'torch==%s\n' "${TORCH_VERSION%%+*}" > /etc/pip-constraints.txt \
 && cat /etc/pip-constraints.txt
ENV PIP_CONSTRAINT=/etc/pip-constraints.txt

# torch first and alone: it drags in the nvidia-* CUDA wheels and resolving it alongside
# everything else makes pip's backtracking miserable.
#
# `--extra-index-url https://pypi.org/simple` is load-bearing, not belt-and-braces. With
# `--index-url` alone the PyTorch index is the ONLY index, and it carries torch and the
# nvidia-* wheels but none of torch's pure-python dependencies -- so the install "succeeds"
# and then `import torch` dies on a missing `typing_extensions`. That is exactly how this
# build failed the second time.
RUN python3 -m pip install --no-cache-dir \
        --index-url "${TORCH_INDEX_URL}" --extra-index-url https://pypi.org/simple \
        "torch==${TORCH_VERSION}"

RUN python3 -m pip install --no-cache-dir \
        "transformers==${TRANSFORMERS_VERSION}" \
        safetensors "huggingface_hub>=1.5" "pydantic>=2.7" numpy accelerate \
        --ignore-installed typing_extensions \
 && python3 -m pip install --no-cache-dir \
        "flash-linear-attention[cuda]==${FLA_VERSION}"

# causal-conv1d compiles against the local CUDA toolkit and has no wheel for every combo.
# Its absence is tolerated: transformers falls back to a reference conv path, which is
# slower but correct. A hard failure here would make the image unbuildable for a speedup
# that is not load-bearing. The marker file records which way it went, so a performance
# investigation can tell immediately.
RUN set -eux; \
    if python3 -m pip install --no-cache-dir --no-build-isolation \
            "causal-conv1d==${CAUSAL_CONV1D_VERSION}"; then \
        echo "installed" > /opt/CAUSAL_CONV1D; \
    else \
        echo "ABSENT -- transformers will use its reference conv path" > /opt/CAUSAL_CONV1D; \
    fi; \
    cat /opt/CAUSAL_CONV1D

# Fail the build rather than ship a silently-degraded image. `importlib.metadata.version`
# and NOT `import triton`: importing it constructs a driver and raises
# "0 active drivers ([])" on a GPU-less builder, which is every builder.
RUN python3 - <<'PYCHK'
import importlib.metadata as md
import torch
from packaging.version import Version

tv = md.version("triton")
assert Version(tv) >= Version("3.3"), f"triton {tv} < 3.3; fla's kernels need 3.3+"
trf = md.version("transformers")
assert Version(trf) >= Version("5.18"), f"transformers {trf} < 5.18"

# The pin must have HELD. A silent upgrade is what broke this build once already, and the
# symptom appeared only at container start, inside Triton, as an opaque
# "duplicate template name". Fail here instead.
assert torch.__version__.startswith("2.7.1"), (
    f"torch is {torch.__version__}, expected 2.7.1+cu126. Something upgraded it past the "
    "constraint file; fla 0.5.2 raises AssertionError('duplicate template name') on "
    "torch 2.14.x."
)

# NOT `import fla` here, however tempting. Importing it evaluates `@triton.autotune`
# decorators, which construct a benchmarker, which initialises the CUDA driver -- and
# BuildKit exposes no GPU to RUN, so it dies with:
#
#     RuntimeError: 0 active drivers ([]). There should only be one.
#
# I added that import, it failed exactly this way, and it is the same reason the version
# checks above read `importlib.metadata` rather than importing the packages. The version
# assertions are what actually catch the torch/fla mismatch; whether fla ends up on CUDA
# can only be checked with a GPU attached, which is model.py::_assert_fla_on_gpu at
# container start.
print(f"OK torch={torch.__version__} triton={tv} transformers={trf} "
      f"fla={md.version('fla-core')}")
PYCHK

# ---- the application
# Appended, not replaced -- see the merge stage above. Clobbering the DLC's
# PYTHONPATH removes typing_extensions and /opt/tritonserver from sys.path.
ENV PYTHONPATH=/opt/strands-decider:/opt/decider-triton:$PYTHONPATH
COPY src/strands_decider /opt/strands-decider/strands_decider
COPY src/decider_triton  /opt/decider-triton/decider_triton
# /opt/ml/model, NOT /opt/ml/model_repository. The DLC's own launcher hard-codes
# `SAGEMAKER_SINGLE_MODEL_REPO=/opt/ml/model/` (/usr/bin/serve:28) and then requires
# ${SAGEMAKER_MODEL_REPO}/${SAGEMAKER_TRITON_DEFAULT_MODEL_NAME} to exist, so the model
# has to land at /opt/ml/model/decider/. Getting this wrong fails at container start with
# "Directory with provided SAGEMAKER_TRITON_DEFAULT_MODEL_NAME decider does not exist".
#
# Supplying a ModelDataUrl would untar OVER this directory, which is why the weights are
# baked into the image instead and no ModelDataUrl is set (see deploy/create_endpoint.py).
COPY model_repository    /opt/ml/model

# Strip macOS AppleDouble turds. The build context is produced on a Mac, and a stray
# `._decider` beside `decider/` makes Triton try to load it as a second model. Deleted
# here rather than only in the tar command, so it cannot depend on who built the context.
RUN find /opt/ml/model /opt/strands-decider /opt/decider-triton \
         -name '._*' -delete -o -name '.DS_Store' -delete 2>/dev/null; \
    echo "model repository:"; ls -la /opt/ml/model/

# ---- weights, from the merge stage. No network needed at run time.
COPY --from=merge /opt/decider /opt/strands-decider/checkpoint
COPY --from=merge /opt/merged  /opt/strands-decider/merged

# Caches must be writable and must NOT default to a read-only or per-restart location.
# TRITON_CACHE_DIR is the GPU kernel cache: 31 MB / 534 files once warm, and worth 54.2 s
# -> 20.7 s on start. It cannot be populated by `docker build` (BuildKit exposes no GPU to
# RUN), so on SageMaker the route is `docker commit` of a warmed container -- see
# README.md ("Verification and measurement"). Keyed on GPU arch + Triton version, so one
# warm image per arch.
ENV TRITON_CACHE_DIR=/opt/strands-decider/triton-cache \
    TORCHINDUCTOR_CACHE_DIR=/opt/strands-decider/inductor-cache \
    XDG_CACHE_HOME=/opt/strands-decider/cache \
    HF_HOME=/opt/strands-decider/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false

ENV SD_CHECKPOINT=/opt/strands-decider/checkpoint \
    SD_MERGED_TORSO=/opt/strands-decider/merged \
    SD_ENGINE=merged \
    SD_PREFIX_CACHE=1 \
    SD_DEVICE=cuda \
    SD_MAX_BATCH=32

# SageMaker reads the model repository from here and expects the single model's name in
# SAGEMAKER_TRITON_DEFAULT_MODEL_NAME.
# SAGEMAKER_TRITON_METRICS_PORT must be inside SageMaker's safe range [23000, 23999].
# With metrics enabled and no port set, Triton defaults to 8002 and the container dies at
# start: "The server cannot listen to metrics requests at port 8002, allowed port range is
# [23000, 23999]". The DLC launcher range-checks it at /usr/bin/serve:82.
ENV SAGEMAKER_TRITON_DEFAULT_MODEL_NAME=decider \
    SAGEMAKER_TRITON_ALLOW_METRICS=true \
    SAGEMAKER_TRITON_METRICS_PORT=23000

RUN mkdir -p /opt/strands-decider/triton-cache \
             /opt/strands-decider/inductor-cache \
             /opt/strands-decider/cache \
             /opt/strands-decider/hf \
 && python3 -c "import strands_decider.merged_engine, decider_triton.wire; print('imports ok')"

EXPOSE 8080 8000 8001 8002

# The DLC's own entrypoint handles SageMaker's `serve` verb and the 8080 wiring; leaving it
# alone is the point of building FROM the DLC rather than NGC.
